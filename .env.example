# AION Data — environment configuration (PLACEHOLDERS ONLY — never commit real secrets).
#
# aion-docs/architecture/security-model.md: "No secrets in any repository — ever."
# Copy to `.env` for local development and fill with LOCAL, non-production values.
# Production secrets are owned by aion-infra's managed secret store, not this file.

# ── Application database connection ──────────────────────────────────────────
# The connection AION Data uses at runtime. Should point at the least-privileged
# application role (DML only — see docs/security.md), never a superuser.
DATABASE_URL=postgresql://aion_app:CHANGE_ME_LOCAL_ONLY@localhost:5432/aion_data

# ── Migration / admin connection (optional) ─────────────────────────────────
# Migrations require DDL privileges and run under a separate, higher-privileged
# role. If unset, migrations fall back to DATABASE_URL (fine for local dev).
# MIGRATION_DATABASE_URL=postgresql://aion_migrator:CHANGE_ME_LOCAL_ONLY@localhost:5432/aion_data

# ── Test database connection ────────────────────────────────────────────────
# Used by the integration test suite. MUST be an isolated, disposable database —
# the suite truncates and rebuilds schema. Never point this at real data.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aion_data_test
